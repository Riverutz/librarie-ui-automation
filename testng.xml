<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Librarie.net Regression Suite" parallel="classes" thread-count="4">
    <listeners>
        <listener class-name="utils.TestListener"/>
    </listeners>
    <test name="Client Account Tests" parallel="none">
        <packages>
            <package name="tests.clientaccount"/>
        </packages>
    </test>
    <test name="Cart Tests">
        <packages>
            <package name="tests.cart"/>
        </packages>
    </test>
    <test name="Search Tests">
        <packages>
            <package name="tests.search"/>
        </packages>
    </test>
    <test name="Product Tests">
        <packages>
            <package name="tests.product"/>
        </packages>
    </test>
</suite>